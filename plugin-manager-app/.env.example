# Postgres
POSTGRES_USER=pluginmgr
POSTGRES_PASSWORD=pluginmgr
POSTGRES_DB=pluginmgr

# Backend
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345

# License activation (Synthlab desktop client)
# Ed25519 private key (PKCS8 PEM) that signs activation tokens. Generate with
#   node backend/scripts/generate-license-keypair.js
# and paste the matching PUBLIC key into the Synthlab client (kPublicKeyB64).
# Single line, real newlines escaped as \n. KEEP SECRET — never commit the real one.
LICENSE_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Default number of devices (seats) per license.
LICENSE_MAX_ACTIVATIONS=3

# Email (SMTP). Leave SMTP_HOST empty to disable email (calls are logged + skipped).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pueski Audio <noreply@pueski.de>
# Public URL of the web app, used for links in emails (reset/login). Defaults to FRONTEND_URL.
APP_BASE_URL=
PASSWORD_RESET_TTL_MINUTES=60

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# URLs
FRONTEND_URL=http://localhost:8080
# Leer lassen: das Frontend nutzt dann relative URLs (Nginx proxyt /api → backend).
# Nur setzen, wenn das Frontend separat gehostet wird (z. B. https://api.example.com).
API_BASE_URL=
